// filesearch.rc — Windows resource file
// Compiled with windres (MinGW) or rc.exe (MSVC)

#include <windows.h>

// Embed the application manifest
1 RT_MANIFEST "filesearch.exe.manifest"

// Version information block
VS_VERSION_INFO VERSIONINFO
  FILEVERSION      1,0,1,0
  PRODUCTVERSION   1,0,1,0
  FILEFLAGSMASK    0x3fL
  FILEFLAGS        0x0L
  FILEOS           VOS__WINDOWS32
  FILETYPE         VFT_APP
  FILESUBTYPE      VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "FileSearch"
      VALUE "FileDescription",  "FileSearch — Local File Search Engine"
      VALUE "FileVersion",      "1.0.1.0"
      VALUE "InternalName",     "filesearch"
      VALUE "LegalCopyright",   "Copyright (C) 2025 FileSearch"
      VALUE "OriginalFilename", "filesearch.exe"
      VALUE "ProductName",      "FileSearch"
      VALUE "ProductVersion",   "1.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
